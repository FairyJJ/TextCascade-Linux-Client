[Unit]
Description=TextCascade clipboard sync client
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/textcascade-client --server https://your-server.example:8443 --username YOUR_USERNAME --password-file %h/.config/textcascade/password --name Linux
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
